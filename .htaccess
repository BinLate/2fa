# START Rewrite for 2FA URL Params
# Keep path rewrite for legacy Copy Link URLs: /{BASE32_SECRET} → index.html.
# New links use hash only: /#s={SECRET} (hash is not sent to Apache / access logs).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Nếu không phải là file có thật
  RewriteCond %{REQUEST_FILENAME} !-f
  # Và không phải là thư mục có thật
  RewriteCond %{REQUEST_FILENAME} !-d
  # Thì chuyển toàn bộ request về index.html
  RewriteRule ^(.*)$ index.html [L,QSA]
</IfModule>
# END Rewrite for 2FA URL Params
